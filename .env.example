# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.abelen-immobilien.de

# Supabase project powering the property database, the enquiry inbox, admin
# login and image storage (see /admin). Safe to expose to the browser —
# access is enforced by Row Level Security, not by keeping these secret.
# Never put the service_role key here: it would end up in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (https://resend.com) delivers the contact form by e-mail. Enquiries
# are stored in Supabase either way, so without these the form still works —
# the enquiry simply arrives in /admin/anfragen instead of the inbox.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@abelen-immobilien.de

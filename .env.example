# Public site URL used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.abelen-immobilien.de

# Supabase project powering the property database, admin login and image
# storage (see /admin). Safe to expose to the browser — access is enforced
# by Row Level Security, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (https://resend.com) is used to deliver the contact form. Without
# these, the form validates but responds with a 503 asking users to call.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@abelen-immobilien.de
